# SentinelAI-X Environment Configuration Template
# Copy this file to .env and configure your secrets

# Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Security & Authentication
SECRET_KEY=change_this_to_a_secure_random_64_char_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///sentinelai.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelai_db

# File Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=10485760
